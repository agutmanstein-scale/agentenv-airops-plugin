# /etc/airops-stream.env: read by the airops-* units; start.sh edits it. Restart a unit after editing by hand.
AIROPS_URL=http://127.0.0.1:8765/web/index.html?live=http://127.0.0.1:8765&stream
AIROPS_SIZE=1920x1080
AIROPS_FPS=30
AIROPS_PAGE_FPS=0
AIROPS_VBITRATE=6000k
AIROPS_ABITRATE=128k
AIROPS_DISPLAY=:0
AIROPS_RELAY=rtmp://127.0.0.1:1935/airops
AIROPS_TARGET=none
AIROPS_SSM_SERVER=/airops-live/x-server
AIROPS_SSM_KEY=/airops-live/x-key
AIROPS_SAFE_URL=http://127.0.0.1:8765/live/state.json
AIROPS_MEM_SOFT_MB=6000
AIROPS_MEM_HARD_MB=9000
AIROPS_RESTART_HOURS=0
AIROPS_MIN_FREE_GB=8
AWS_DEFAULT_REGION=us-west-2
