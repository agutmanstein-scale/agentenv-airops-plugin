# The live tooling's settings. Copy to live/live.env (git-ignored), fill it in; every laptop script sources it.
# Another file: LIVE_ENV=/path/to/file before the command. No secret goes here: keys live in SSM (aws/put-secret.sh).

# AWS: the profile is forced for every call when set (a shell's own AWS_PROFILE is then ignored); empty uses the
# shell's credentials. With LIVE_AWS_ACCOUNT set, every script first checks the credentials are that account's.
LIVE_AWS_PROFILE=
LIVE_AWS_ACCOUNT=
LIVE_AWS_REGION=us-west-2

# Where boxes launch: a subnet with a route to the internet (apt, PyPI, GitHub, the model endpoint, X's ingest, the
# viewer's map tiles), a security group (no inbound rule is needed: everything goes through SSM) and an instance
# profile whose role has AmazonSSMManagedInstanceCore (it also reads the SecureString parameters below).
LIVE_SUBNET=
# launch-gpu.sh tries each of these subnets in turn (GPU capacity moves between zones); default LIVE_SUBNET.
LIVE_SUBNETS=
LIVE_SECURITY_GROUP=
LIVE_INSTANCE_PROFILE=
# launch-gpu.sh's instance types, in order.
LIVE_GPU_TYPES="g6.4xlarge gr6.4xlarge g6.8xlarge"
# Tags on every box; teardown.sh terminates only a box with this purpose tag. Owner default: $USER.
LIVE_TAG_OWNER=
LIVE_TAG_PURPOSE=airops-live

# Transfers: code bundles, the server's data, results, clips and recordings go through this bucket (in LIVE_AWS_REGION)
# under LIVE_S3_PREFIX, with presigned URLs, so the boxes need no S3 rights.
LIVE_BUCKET=
LIVE_S3_PREFIX=airops-live

# The code: the box clones LIVE_REPO_URL and checks out your branch, shipped as a git bundle over LIVE_BASE_REF (a tag
# of LIVE_REPO_URL that the branch contains), in a venv with LIVE_PINS.
LIVE_REPO_URL=https://github.com/earakely-scale/agentenv-airops-plugin.git
LIVE_BASE_REF=v0.5.0
LIVE_PINS="agentenv-framework==0.9.1339 agentenv-framework-protocol==0.1.354 highspy==1.15.1 numpy==2.5.4 pandas==3.0.6 pyarrow==26.0.0 shapely==2.2.0 airportsdata==20260905"

# The model: a LiteLLM-compatible endpoint (OpenAI-style chat), its key in SSM, and the model the desks play
# (scripts/live_runner.toml's model when empty).
LIVE_LITELLM_BASE_URL=
LIVE_LITELLM_KEY_PARAM=/airops-live/litellm-key
LIVE_MODEL=openai/gpt-6-astra

# X (or any RTMP target): the server URL and the stream key, each a SecureString in SSM.
LIVE_X_SERVER_PARAM=/airops-live/x-server
LIVE_X_KEY_PARAM=/airops-live/x-key
