  {
    "id": "clock",
    "type": "sync_env_clock",
    "env_id": "airops-day",
    "virtual_time": "2024-01-07T10:00:00Z",
    "virtual_seconds_per_real_second": 0,
    "tolerate_missing_sync_time": false
