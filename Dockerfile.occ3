# The AirOps ops control center with passengers env: the airops-occ3 MCP server with the b6-v3 pack and its realistic
# days (b6-v3r), on port 18765.
#   Build: agent-env airops-occ3 setup   (docker build -f Dockerfile.occ3 -t agentenv-airops-occ3-env .)
FROM python:3.12-slim
LABEL org.opencontainers.image.source="https://github.com/earakely-scale/agentenv-airops-plugin" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="AirOpsEnv's ops control center with passengers as an AgentEnv environment. Built from public U.S. records: BTS on-time and T-100 data, the DB1B and DB1C passenger surveys, the FAA registry and FAA Command Center advisories."
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 AIROPS_OCC3_PACK=/app/data/b6-v3 \
    AIROPS_OCC3R_PACK=/app/data/b6-v3r
RUN pip install "agentenv-framework-protocol==0.1.338" "fastmcp==3.4.8" "mcp==1.30.0" "pydantic==2.13.5" "tzdata" \
    "httpx==0.28.1" "numpy==2.5.4" "pandas==3.0.6" "highspy==1.15.1" "airportsdata==20260905"
WORKDIR /app
COPY LICENSE NOTICE /app/
COPY data/b6-v3 /app/data/b6-v3
COPY data/b6-v3r /app/data/b6-v3r
COPY src/agentenv_airops /app/agentenv_airops
RUN useradd --create-home --uid 1000 airops
USER airops
EXPOSE 18765
CMD ["python", "-m", "agentenv_airops.occ3_server"]
